# Project name defaults to the folder name, so each project folder gets its
# own containers and database. Only set this if two folders share the same name.
# COMPOSE_PROJECT_NAME=my-wordpress

# Database Configuration (local only - defaults are fine)
DB_ROOT_PASSWORD=admin
DB_NAME=wordpress
# Must NOT be "root" - MariaDB creates this as a regular user
DB_USER=admin
DB_PASSWORD=admin

# WordPress Configuration
# Pick before the first run - images inserted into posts keep this port in their URL
WP_PORT=8080
# 1 = show PHP errors / write wp-content/debug.log, 0 = off
WP_DEBUG=0

# phpMyAdmin Configuration
PMA_PORT=8081
